# Auto-resume bc250-cu-bisect.sh after every reboot (used with the --auto flag).
#
# Install (as your normal user, not root):
#   mkdir -p ~/.config/systemd/user
#   cp bc250-cu-bisect-auto.service.example ~/.config/systemd/user/bc250-cu-bisect-auto.service
#   # edit ExecStart below to the real path of bc250-cu-bisect.sh, and the -t/-r options you want
#   systemctl --user enable --now bc250-cu-bisect-auto.service
#
# Stop the auto-resume loop early if needed (when all attempts finish, the script itself disables
# this unit and removes the watch autostart entry below; a later --auto run re-enables it by itself):
#   systemctl --user disable --now bc250-cu-bisect-auto.service
#
# --auto skips every interactive prompt (assumes a crash on an unfinished attempt, continues past
# warnings, and reboots on its own) and needs passwordless sudo for umr and journalctl, see README.
#
# Optional: live output on screen at every login. The unit below only appends to auto.log; to also
# get a terminal window that follows it, add a desktop autostart entry (KDE example):
#
#   cat > ~/.config/autostart/bc250-cu-bisect-watch.desktop <<'EOF'
#   [Desktop Entry]
#   Type=Application
#   Name=BC-250 bisect live output
#   Exec=konsole --title "bc250-cu-bisect" -e tail -n 40 -f .local/share/bc250-cu-bisect/auto.log
#   EOF
#
# In --auto mode the script removes this file automatically when the run is finished.

[Unit]
Description=BC-250 CU bisect - auto-resume after reboot
# default.target starts at every user login (graphical or not); gamescope/Steam sessions
# don't always activate graphical-session.target, so don't depend on it.

[Service]
Type=oneshot
# Give the desktop and GPU a few seconds to settle before testing.
ExecStartPre=/bin/sleep 20
# Example: add the correct path to bc250-cu-bisect.sh
ExecStart=/home/admin/IdeaProjects/bc250-cu-bisect/bc250-cu-bisect.sh --auto -t 60 -r 2
StandardOutput=append:%h/.local/share/bc250-cu-bisect/auto.log
StandardError=append:%h/.local/share/bc250-cu-bisect/auto.log

[Install]
WantedBy=default.target
