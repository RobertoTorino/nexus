#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Starts the RPCS3 that RPCS3 Manager installed, with the arguments given:
#
#   bc250-rpcs3-run --no-gui --fullscreen /path/to/USRDIR/EBOOT.BIN   a game alone, full screen (the Steam shortcuts)
#   bc250-rpcs3-run --no-gui /path/to/USRDIR/EBOOT.BIN                a game alone, in a window
#   bc250-rpcs3-run --installfw /path/to/PS3UPDAT.PUP                 install the PS3 firmware
#   bc250-rpcs3-run --installpkg /path/to/folder                      install the .pkg (and .rap) files in a folder
#   bc250-rpcs3-run --headless --installpkg /path/to/file.pkg         the same without RPCS3's window (the app)
#   bc250-rpcs3-run                                                   RPCS3's own window, for its settings
#
# The Steam shortcuts run this, not the AppImage, so they keep working when the app brings another RPCS3.
set -euo pipefail

APPIMAGE="${XDG_DATA_HOME:-$HOME/.local/share}/bc250-rpcs3-manager/emulator/current/rpcs3.AppImage"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi
[ -x "$APPIMAGE" ] || {
    echo "RPCS3 is not installed: open RPCS3 Manager and press Install." >&2
    exit 1
}
# RPCS3's AppImage mounts itself with its own FUSE library and the system's fusermount (part of Bazzite); without
# fusermount, it unpacks itself to a temporary folder on every start instead.
if ! command -v fusermount3 >/dev/null 2>&1 && ! command -v fusermount >/dev/null 2>&1; then
    export APPIMAGE_EXTRACT_AND_RUN=1
fi
# A game started by Steam gets SDL told to ignore the controllers Steam handles, and Steam's virtual controller
# (28DE:11FF) in their place: no motion sensors, and on the desktop it follows Steam's Desktop Configuration (mouse
# and keys). As shadPS4 Manager and Console Link do: while a real controller is connected, RPCS3's SDL
# handler reads it and leaves Steam's virtual one out. Without a real one (a Steam Deck's own controls) Steam's
# choice stands.
INPUT_DEVICES="${BC250_INPUT_DEVICES:-/proc/bus/input/devices}"      # another file only in the tests
real_controller() {
    # A joystick (js handler) that is not one of Steam's (vendor 28DE).
    awk '/^I:/ { vendor = ""; for (i = 1; i <= NF; i++) if ($i ~ /^Vendor=/) vendor = tolower(substr($i, 8)) }
         /^H:/ && / js[0-9]/ && vendor != "28de" { found = 1 }
         END { exit !found }' "$INPUT_DEVICES" 2>/dev/null
}
if [ -n "${SDL_GAMECONTROLLER_IGNORE_DEVICES:-}${SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT:-}" ] && real_controller; then
    unset SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT
    export SDL_GAMECONTROLLER_IGNORE_DEVICES=0x28DE/0x11FF
fi
# On a Wayland desktop RPCS3 (a Qt program) opens its windows through Wayland itself, and Steam sees only X11
# windows: no overlay (Shift+Tab, the PS button) over a game it started. A game Steam starts there opens its window
# through XWayland, as shadPS4 Manager does for shadPS4. Game Mode is X11 already.
if [ -n "${SteamGameId:-}" ] && [ -n "${WAYLAND_DISPLAY:-}" ] && [ -n "${DISPLAY:-}" ] &&
   [ -z "${QT_QPA_PLATFORM:-}" ]; then
    export QT_QPA_PLATFORM=xcb
fi
# The game started goes to the app's log (the Log tab), in the app's own form, by its folder's name (the disc's, or
# the installed game's ID) and from where (Steam sets SteamGameId); nothing else is known here. As PCSX2 Manager's
# wrapper does (owner, 24-10-2026).
LOG="${XDG_DATA_HOME:-$HOME/.local/share}/bc250-rpcs3-manager/bc250-rpcs3-manager.log"
game=""
install=""
for arg in "$@"; do
    game=$arg
    case $arg in --installfw|--installpkg|--headless) install=1 ;; esac
done
if [ -n "$game" ] && [ "${game#-}" = "$game" ] && [ -z "$install" ]; then
    name=${game%/USRDIR/EBOOT.BIN}
    name=${name%/PS3_GAME}
    name=${name##*/}
    from="from a terminal"
    [ -n "${SteamGameId:-}" ] && from="from Steam"
    if real_controller; then
        pad="with a controller"
    else
        pad="without a controller"
        # Said on the desktop too (a controller switched off by its idle timer; owner, 24-10-2026): the game is
        # starting, so the window is not where the eyes are.
        if [ -n "${SteamGameId:-}" ] && command -v notify-send >/dev/null 2>&1; then
            notify-send -a "RPCS3 Manager" -i input-gaming "No controller connected" \
                "Switch your controller on, or press its PS button to wake it. RPCS3 plays with the keyboard only until then." \
                2>/dev/null || true
        fi
    fi
    if [ -d "${LOG%/*}" ]; then
        printf -v stamp '%(%d-%m-%Y %H:%M:%S)T' -1
        printf '%s INFO Started %s %s, %s.\n' "$stamp" "${name:-$game}" "$from" "$pad" >>"$LOG" 2>/dev/null || true
    fi
fi
exec "$APPIMAGE" "$@"
