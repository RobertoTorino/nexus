#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# bc250-mesh-shaders-run: starts a game with the DirectMesh RADV of BC-250 Mesh Shaders. Steam launch options:
#
#   /usr/local/bin/bc250-mesh-shaders-run %command%
#
# The game gets the driver only when the test passed with the running kernel and the installed driver; otherwise it
# starts with the system Mesa, and the reason goes to ~/.local/state/bc250-mesh-shaders/run.log.
PREFIX=/usr/local/lib/bc250-mesh-shaders
TESTED="$HOME/.local/state/bc250-mesh-shaders/tested"
LOG="$HOME/.local/state/bc250-mesh-shaders/run.log"

[ $# -gt 0 ] || { echo "Usage: $0 <command>   (Steam launch options: $0 %command%)" >&2; exit 2; }

# One line per start: what the game got, and the game (Steam's AppId=, else the program's name).
note() {
    local game="" arg
    for arg in "${@:2}"; do case "$arg" in AppId=*) game=$arg; break ;; esac; done
    mkdir -p "$(dirname "$LOG")" 2>/dev/null &&
        echo "$(date '+%Y-%m-%d %H:%M:%S') ${game:-$(basename "$2")}: $1" >>"$LOG" 2>/dev/null
}

# The switches set in the launch options, for the log (RADV_DIRECTMESH, RADV_BC250_*, RADV_DEBUG).
switches() {
    local name out=""
    for name in RADV_DIRECTMESH RADV_DEBUG $(compgen -v RADV_BC250_ || true); do
        [ -n "${!name:-}" ] && out="$out $name=${!name}"
    done
    [ -n "$out" ] && printf ',%s' "$out"
}

kernel=$(sed -n 's/^kernel=//p' "$TESTED" 2>/dev/null)
driver=$(sed -n 's/^driver=//p' "$TESTED" 2>/dev/null)
sum=$(sha256sum "$PREFIX/lib64/libvulkan_radeon.so" 2>/dev/null | cut -d' ' -f1)
if [ -z "$sum" ]; then
    note "system Mesa (the DirectMesh driver is not installed)" "$@"
elif [ "$kernel" != "$(uname -r)" ] || [ "$driver" != "$sum" ]; then
    note "system Mesa (the test has not passed on kernel $(uname -r) with this driver)" "$@"
else
    # The DirectMesh 64-bit driver, the stock 32-bit one (Proton's 32-bit helpers need one) and lavapipe
    # (VK_DRIVER_FILES replaces the loader's search, so without it there would be no Vulkan at all if amdgpu ever
    # failed to load).
    files="$PREFIX/share/vulkan/icd.d/radeon_icd.x86_64.json"
    for f in /usr/share/vulkan/icd.d/radeon_icd.i686.json /usr/share/vulkan/icd.d/lvp_icd.x86_64.json; do
        [ -f "$f" ] && files="$files:$f"
    done
    export VK_DRIVER_FILES="$files" VK_ICD_FILENAMES="$files"
    note "DirectMesh RADV$(switches)" "$@"
fi
exec "$@"
