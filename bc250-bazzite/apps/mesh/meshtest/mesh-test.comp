// The mesh test's work for the compute queues: every invocation writes a value that depends on its index and the
// seed, so a workgroup that runs partly, twice or not at all leaves a wrong value behind. The test dispatches a count
// that is not a multiple of 64, so the last workgroup is a partial one.
#version 450

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Out { uint data[]; };

layout(push_constant) uniform Push { uint count; uint seed; } push;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= push.count)
        return;
    uint v = i * 2654435769u ^ push.seed;
    for (uint k = 0u; k < 8u; ++k) {        // xorshift32
        v ^= v << 13;
        v ^= v >> 17;
        v ^= v << 5;
    }
    data[i] = v;
}
