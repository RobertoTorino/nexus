// The mesh test's task shader: each task workgroup launches MESH_PER_TASK mesh workgroups and hands them the first
// row they draw. Draws with a task shader run part of their work on a compute queue beside the graphics queue.
#version 460
#extension GL_EXT_mesh_shader : require

#define MESH_PER_TASK 4u

layout(local_size_x = 1) in;

struct Payload { uint first_row; };
taskPayloadSharedEXT Payload payload;

void main()
{
    payload.first_row = gl_WorkGroupID.x * MESH_PER_TASK;
    EmitMeshTasksEXT(MESH_PER_TASK, 1, 1);
}
