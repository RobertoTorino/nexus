// SPDX-License-Identifier: GPL-3.0-or-later
// The mesh test's mesh shader: each workgroup draws ROWS rows of the 16 x 16 tile grid, every tile a quad of two
// triangles in its own colour. Compiled twice:
//   -DTASK -DROWS=1   behind the task shader: 32 invocations, 64 vertices, 32 triangles;
//   -DROWS=4          alone: 128 invocations, 256 vertices, 128 triangles, the largest meshlet the extension
//                     allows, which the driver has to split into pieces on this chip.
#version 460
#extension GL_EXT_mesh_shader : require

#define TILES 16u                       // per row and per column
#define TRIANGLES (ROWS * TILES * 2u)

layout(local_size_x = TRIANGLES) in;
layout(triangles, max_vertices = ROWS * TILES * 4u, max_primitives = TRIANGLES) out;

layout(push_constant) uniform Push { uint seed; uint pass; } push;

layout(location = 0) flat out vec4 colour[];

#ifdef TASK
struct Payload { uint first_row; };
taskPayloadSharedEXT Payload payload;
#endif

// The tile's colour; the test computes the same on the CPU. Alpha 1 tells a drawn pixel from the cleared ones.
vec4 tile_colour(uint id)
{
    uint r = (id + push.seed) & 255u;
    uint g = (id * 3u + push.pass * 85u) & 255u;
    uint b = (255u - id) ^ (push.seed >> 8 & 255u);
    return vec4(float(r), float(g), float(b), 255.0) / 255.0;
}

void main()
{
#ifdef TASK
    uint first_row = payload.first_row + gl_WorkGroupID.x;
#else
    uint first_row = gl_WorkGroupID.x * ROWS;
#endif
    uint i = gl_LocalInvocationIndex;
    SetMeshOutputsEXT(ROWS * TILES * 4u, TRIANGLES);

    // Two vertices per invocation: corner c of tile t in this workgroup's rows.
    for (uint k = 0u; k < 2u; ++k) {
        uint v = i * 2u + k, t = v / 4u, c = v % 4u;
        uint row = first_row + t / TILES, col = t % TILES;
        vec2 pixel = vec2(col * 16u + (c & 1u) * 16u, row * 16u + (c >> 1) * 16u);
        gl_MeshVerticesEXT[v].gl_Position = vec4(pixel / 128.0 - 1.0, 0.0, 1.0);
        colour[v] = tile_colour(row * TILES + col);
    }
    // One triangle per invocation: half of tile i / 2.
    uint base = (i / 2u) * 4u;
    gl_PrimitiveTriangleIndicesEXT[i] = (i & 1u) == 0u ? uvec3(base, base + 1u, base + 2u)
                                                       : uvec3(base + 1u, base + 3u, base + 2u);
}
