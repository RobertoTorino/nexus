+/* RADV_BC250_MESH_SPLIT_WRITES: buffer and global stores (an atomic store included) are guarded
+ * to the first piece like image stores. */
+static bool
+bc250_split_buffer_store(const nir_intrinsic_instr *in)
+{
+   return in->intrinsic == nir_intrinsic_store_ssbo || in->intrinsic == nir_intrinsic_store_global ||
+          in->intrinsic == nir_intrinsic_store_global_amd;
+}
+
+/* The writes the split runs in the first piece only. */
+static bool
+bc250_split_guarded_write(const nir_intrinsic_instr *in, bool stores, bool writes)
+{
+   return (nir_intrinsic_has_atomic_op(in) && nir_intrinsic_writes_external_memory(in)) ||
+          (stores && bc250_split_image_store(in)) || (writes && bc250_split_buffer_store(in));
+}
+
+/* RADV_BC250_MESH_SPLIT_WRITES: what an if decided by an external atomic's result may hold: guarded
+ * writes, values, reads and memory fences, nothing a later piece could keep. */
+static bool
+bc250_split_decided_region(struct exec_list *list, bool stores)
+{
+   foreach_list_typed(nir_cf_node, node, node, list) {
+      switch (node->type) {
+      case nir_cf_node_block:
+         nir_foreach_instr(instr, nir_cf_node_as_block(node)) {
+            if (instr->type == nir_instr_type_jump || instr->type == nir_instr_type_call)
+               return false;
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *in = nir_instr_as_intrinsic(instr);
+            if (!bc250_split_guarded_write(in, stores, true) &&
+                !(in->intrinsic == nir_intrinsic_barrier && nir_intrinsic_execution_scope(in) == SCOPE_NONE) &&
+                !(nir_intrinsic_infos[in->intrinsic].flags & NIR_INTRINSIC_CAN_ELIMINATE))
+               return false;
+         }
+         break;
+      case nir_cf_node_if:
+         if (!bc250_split_decided_region(&nir_cf_node_as_if(node)->then_list, stores) ||
+             !bc250_split_decided_region(&nir_cf_node_as_if(node)->else_list, stores))
+            return false;
+         break;
+      case nir_cf_node_loop:
+         if (!bc250_split_decided_region(&nir_cf_node_as_loop(node)->body, stores) ||
+             !bc250_split_decided_region(&nir_cf_node_as_loop(node)->continue_list, stores))
+            return false;
+         break;
+      default:
+         return false;
+      }
+   }
+   return true;
+}
+
+/* RADV_BC250_MESH_SPLIT_WRITES: the used results of external atomics only decide other guarded
+ * writes. Every value computed from one (ALU, phis, and the phis after an if it decides) may only
+ * reach guarded writes and if conditions, and such an if only holds a decided region. The writes
+ * run in the first piece; the other pieces see zero and keep nothing that depends on it. */
+static bool
+bc250_split_results_confined(struct util_dynarray *results, bool stores)
+{
+   struct set *seen = _mesa_pointer_set_create(NULL);
+   struct util_dynarray work;
+   util_dynarray_init(&work, NULL);
+   util_dynarray_foreach(results, nir_def *, it) {
+      _mesa_set_add(seen, *it);
+      util_dynarray_append(&work, *it);
+   }
+   bool ok = true;
+   while (ok && util_dynarray_num_elements(&work, nir_def *)) {
+      nir_def *def = util_dynarray_pop(&work, nir_def *);
+      nir_foreach_use_including_if(src, def) {
+         nir_def *next = NULL;
+         if (nir_src_is_if(src)) {
+            nir_if *nif = nir_src_use_if(src);
+            if (!bc250_split_decided_region(&nif->then_list, stores) ||
+                !bc250_split_decided_region(&nif->else_list, stores)) {
+               ok = false;
+               break;
+            }
+            nir_foreach_phi(phi, nir_cf_node_as_block(nir_cf_node_next(&nif->cf_node))) {
+               if (!_mesa_set_search(seen, &phi->def)) {
+                  _mesa_set_add(seen, &phi->def);
+                  util_dynarray_append(&work, &phi->def);
+               }
+            }
+            continue;
+         }
+         nir_instr *use = nir_src_use_instr(src);
+         if (use->type == nir_instr_type_alu)
+            next = &nir_instr_as_alu(use)->def;
+         else if (use->type == nir_instr_type_phi)
+            next = &nir_instr_as_phi(use)->def;
+         else if (use->type != nir_instr_type_intrinsic ||
+                  !bc250_split_guarded_write(nir_instr_as_intrinsic(use), stores, true)) {
+            ok = false;
+            break;
+         }
+         if (next && !_mesa_set_search(seen, next)) {
+            _mesa_set_add(seen, next);
+            util_dynarray_append(&work, next);
+         }
+      }
+   }
+   util_dynarray_fini(&work);
+   _mesa_set_destroy(seen, NULL);
+   return ok;
+}
