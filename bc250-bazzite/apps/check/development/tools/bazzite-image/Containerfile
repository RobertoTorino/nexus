# Local Bazzite OCI image for package testing: layers the tools the test suite uses,
# so a rebased board (or container) matches a user's fully set-up system.
# Build with ./build.sh in this directory.
FROM ghcr.io/ublue-os/bazzite:latest

# RPM packages the tests can use (same list as development/tools/install-requirements.sh --rpms).
RUN rpm-ostree install stress-ng lm_sensors vkmark nvme-cli fio

# To test a locally built RPM of this project, drop it next to this file and uncomment:
# COPY ./bc250-bazzite-test-*.rpm /tmp/
# RUN rpm-ostree install /tmp/bc250-bazzite-test-*.rpm && rm -f /tmp/bc250-bazzite-test-*.rpm

# Commit the changes into the OSTree container commit.
RUN rpm-ostree cleanup -a && ostree container commit
