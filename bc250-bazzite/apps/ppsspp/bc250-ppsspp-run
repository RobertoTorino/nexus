#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Starts the PPSSPP that PPSSPP Manager installed, with the arguments given:
#
#   bc250-ppsspp-run --fullscreen --pause-menu-exit /path/to/game.iso   a game full screen (Game Mode)
#   bc250-ppsspp-run /path/to/game.iso                                  a game as PPSSPP is set up
#   bc250-ppsspp-run                                                    PPSSPP's own window, for its settings
#
# The Steam shortcuts run this, not the AppImage, so they keep working when the app brings another PPSSPP.
set -euo pipefail

APPIMAGE="${XDG_DATA_HOME:-$HOME/.local/share}/bc250-ppsspp-manager/emulator/current/ppsspp.AppImage"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '3,9p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi
[ -x "$APPIMAGE" ] || {
    echo "PPSSPP is not installed: open PPSSPP Manager and press Install." >&2
    exit 1
}
# The AppImage mounts itself with its own FUSE library and the system's fusermount (part of Bazzite); without
# fusermount, it unpacks itself to a temporary folder on every start instead.
if ! command -v fusermount3 >/dev/null 2>&1 && ! command -v fusermount >/dev/null 2>&1; then
    export APPIMAGE_EXTRACT_AND_RUN=1
fi
# A game started by Steam gets SDL told to ignore the controllers Steam handles, and Steam's virtual controller
# (28DE:11FF) in their place: no motion sensors, and on the desktop it follows Steam's Desktop Configuration (mouse
# and keys). As RPCS3 Manager and Console Link do: while a real controller is connected, PPSSPP's SDL
# input reads it and leaves Steam's virtual one out. Without a real one (a Steam Deck's own controls) Steam's
# choice stands.
INPUT_DEVICES="${BC250_INPUT_DEVICES:-/proc/bus/input/devices}"      # another file only in the tests
real_controller() {
    # A joystick (js handler) that is not one of Steam's (vendor 28DE).
    awk '/^I:/ { vendor = ""; for (i = 1; i <= NF; i++) if ($i ~ /^Vendor=/) vendor = tolower(substr($i, 8)) }
         /^H:/ && / js[0-9]/ && vendor != "28de" { found = 1 }
         END { exit !found }' "$INPUT_DEVICES" 2>/dev/null
}
if [ -n "${SDL_GAMECONTROLLER_IGNORE_DEVICES:-}${SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT:-}" ] && real_controller; then
    unset SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT
    export SDL_GAMECONTROLLER_IGNORE_DEVICES=0x28DE/0x11FF
fi
# On a Wayland desktop PPSSPP (an SDL program) may open its window through Wayland, and Steam sees only X11
# windows: no overlay (Shift+Tab, the PS button) over a game it started. A game Steam starts there opens its window
# through XWayland, as RPCS3 Manager does for RPCS3 with Qt. Game Mode is X11 already. SDL_VIDEO_DRIVER is the same
# setting under SDL 3, should a later PPSSPP build on it.
if [ -n "${SteamGameId:-}" ] && [ -n "${WAYLAND_DISPLAY:-}" ] && [ -n "${DISPLAY:-}" ] &&
   [ -z "${SDL_VIDEODRIVER:-}" ] && [ -z "${SDL_VIDEO_DRIVER:-}" ]; then
    export SDL_VIDEODRIVER=x11
    export SDL_VIDEO_DRIVER=x11
fi
exec "$APPIMAGE" "$@"
