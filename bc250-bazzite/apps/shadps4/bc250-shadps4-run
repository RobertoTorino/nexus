#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Starts the shadPS4 that shadPS4 Manager installed, with the arguments given:
#
#   bc250-shadps4-run -f true -g /path/to/game/eboot.bin   a game, full screen (the Steam shortcuts)
#   bc250-shadps4-run -g /path/to/game/eboot.bin           a game, as shadPS4's settings say
#   bc250-shadps4-run -b                                   shadPS4's own window (Big Picture), for its settings
#
# The Steam shortcuts run this, not the AppImage, so they keep working when the app brings another shadPS4.
set -euo pipefail

APPIMAGE="${XDG_DATA_HOME:-$HOME/.local/share}/bc250-shadps4-manager/emulator/current/Shadps4-sdl.AppImage"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '3,9p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi
[ -x "$APPIMAGE" ] || {
    echo "shadPS4 is not installed: open shadPS4 Manager and press Install." >&2
    exit 1
}
# shadPS4 takes a folder named "user" in the current folder as its own folder (portable mode), so start it where
# there is none: beside the AppImage.
cd "$(dirname "$APPIMAGE")"
# An AppImage mounts itself with FUSE 2 (libfuse.so.2, part of Bazzite); without it, it unpacks itself to a
# temporary folder on every start instead.
if command -v ldconfig >/dev/null 2>&1 && ! ldconfig -p 2>/dev/null | grep -q 'libfuse\.so\.2'; then
    export APPIMAGE_EXTRACT_AND_RUN=1
fi
# A game started by Steam gets SDL told to ignore the controllers Steam handles, and Steam's virtual controller
# (28DE:11FF) in their place: no motion sensors or touchpad, and on the desktop it follows Steam's Desktop
# Configuration (mouse and keys), so the game got no controller input (owner's board, 14-10-2026). As BC250 Console
# Link does: while a real controller is connected, shadPS4 reads it and leaves Steam's virtual one out. Without a
# real one (a Steam Deck's own controls) Steam's choice stands.
INPUT_DEVICES="${BC250_INPUT_DEVICES:-/proc/bus/input/devices}"      # another file only in the tests
real_controller() {
    # A joystick (js handler) that is not one of Steam's (vendor 28DE).
    awk '/^I:/ { vendor = ""; for (i = 1; i <= NF; i++) if ($i ~ /^Vendor=/) vendor = tolower(substr($i, 8)) }
         /^H:/ && / js[0-9]/ && vendor != "28de" { found = 1 }
         END { exit !found }' "$INPUT_DEVICES" 2>/dev/null
}
if [ -n "${SDL_GAMECONTROLLER_IGNORE_DEVICES:-}${SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT:-}" ] && real_controller; then
    unset SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT
    export SDL_GAMECONTROLLER_IGNORE_DEVICES=0x28DE/0x11FF
fi
# On a Wayland desktop shadPS4 opens its window through Wayland itself, and Steam sees only X11 windows: no overlay
# (Shift+Tab, the PS button) over a game it started, so no way to its page, controller layout or settings (owner's
# board, 14-10-2026). A game Steam starts there opens its window through XWayland. Game Mode is X11 already.
if [ -n "${SteamGameId:-}" ] && [ -n "${WAYLAND_DISPLAY:-}" ] && [ -n "${DISPLAY:-}" ] &&
   [ -z "${SDL_VIDEO_DRIVER:-}" ]; then
    export SDL_VIDEO_DRIVER=x11
fi
# The game started goes to the app's log (the Log tab), in the app's own form, by its folder's name (the game's ID
# as Extract PKG names it) and from where (Steam sets SteamGameId); nothing else is known here. As PCSX2 Manager's
# wrapper does (owner, 24-10-2026).
LOG="${XDG_DATA_HOME:-$HOME/.local/share}/bc250-shadps4-manager/bc250-shadps4-manager.log"
game=""
previous=""
for arg in "$@"; do
    case $previous in -g|--game) game=$arg ;; esac
    previous=$arg
done
if [ -n "$game" ]; then
    name=${game%/*}
    name=${name##*/}
    from="from a terminal"
    [ -n "${SteamGameId:-}" ] && from="from Steam"
    if real_controller; then
        pad="with a controller"
    else
        pad="without a controller"
        # Said on the desktop too (a controller switched off by its idle timer; owner, 24-10-2026): the game is
        # starting, so the window is not where the eyes are.
        if [ -n "${SteamGameId:-}" ] && command -v notify-send >/dev/null 2>&1; then
            notify-send -a "shadPS4 Manager" -i input-gaming "No controller connected" \
                "Switch your controller on, or press its PS button to wake it. shadPS4 plays with the keyboard only until then." \
                2>/dev/null || true
        fi
    fi
    if [ -d "${LOG%/*}" ]; then
        printf -v stamp '%(%d-%m-%Y %H:%M:%S)T' -1
        printf '%s INFO Started %s %s, %s.\n' "$stamp" "${name:-$game}" "$from" "$pad" >>"$LOG" 2>/dev/null || true
    fi
fi
exec "$APPIMAGE" "$@"
