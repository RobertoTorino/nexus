#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Starts the Xenia that Xenia Manager installed, with the arguments given:
#
#   bc250-xenia-run --fullscreen=true /path/to/game.iso   a game full screen (Game Mode)
#   bc250-xenia-run /path/to/game.iso                     a game in a window
#   bc250-xenia-run                                       Xenia's own window, for its settings and profiles
#
# The Steam shortcuts run this, not the AppImage, so they keep working when the app brings another Xenia.
set -euo pipefail

APPIMAGE="${XDG_DATA_HOME:-$HOME/.local/share}/bc250-xenia-manager/emulator/current/xenia.AppImage"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '3,9p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi
[ -x "$APPIMAGE" ] || {
    echo "Xenia is not installed: open Xenia Manager and press Install." >&2
    exit 1
}
# The AppImage mounts itself with its own FUSE library and the system's fusermount (part of Bazzite); without
# fusermount, it unpacks itself to a temporary folder on every start instead.
if ! command -v fusermount3 >/dev/null 2>&1 && ! command -v fusermount >/dev/null 2>&1; then
    export APPIMAGE_EXTRACT_AND_RUN=1
fi
# A game started by Steam gets SDL told to ignore the controllers Steam handles, and Steam's virtual controller
# (28DE:11FF) in their place: on the desktop it follows Steam's Desktop Configuration (mouse and keys). As PCSX2
# Manager does: while a real controller is connected, Xenia's SDL input reads it and leaves Steam's virtual one out.
# Without a real one (a Steam Deck's own controls) Steam's choice stands.
INPUT_DEVICES="${BC250_INPUT_DEVICES:-/proc/bus/input/devices}"      # another file only in the tests
real_controller() {
    # A joystick (js handler) that is not one of Steam's (vendor 28DE).
    awk '/^I:/ { vendor = ""; for (i = 1; i <= NF; i++) if ($i ~ /^Vendor=/) vendor = tolower(substr($i, 8)) }
         /^H:/ && / js[0-9]/ && vendor != "28de" { found = 1 }
         END { exit !found }' "$INPUT_DEVICES" 2>/dev/null
}
if [ -n "${SDL_GAMECONTROLLER_IGNORE_DEVICES:-}${SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT:-}" ] && real_controller; then
    unset SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT
    export SDL_GAMECONTROLLER_IGNORE_DEVICES=0x28DE/0x11FF
fi
# Xenia's window is an X11 one on a Wayland desktop too (it sets GDK_BACKEND=x11 for GTK unless it is set), so
# Steam's overlay sees it: nothing to set for that.
exec "$APPIMAGE" "$@"
