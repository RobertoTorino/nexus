// The ACE queue test's dispatch: every invocation writes a value that depends on its index and the seed, so a
// workgroup that runs partly, twice or not at all leaves a wrong value behind. The test dispatches a count that
// is not a multiple of 64, so the last workgroup is a partial one.
#version 450

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Out { uint data[]; };

layout(push_constant) uniform Push { uint count; uint seed; } push;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= push.count)
        return;
    uint v = i ^ push.seed;
    for (uint k = 0u; k < 16u; ++k)
        v = v * 1664525u + 1013904223u;
    data[i] = v;
}
