#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# bc250-ace-queues-run: starts a game with the patched RADV of BC-250 ACE Queues. Steam launch options:
#
#   /usr/local/bin/bc250-ace-queues-run %command%
#
# The game gets the patched driver only when the ACE queue test passed with the running kernel and the installed
# driver; otherwise it starts with the system Mesa, and the reason goes to ~/.local/state/bc250-ace-queues/run.log.
PREFIX=/usr/local/lib/bc250-ace-queues
TESTED="$HOME/.local/state/bc250-ace-queues/tested"
LOG="$HOME/.local/state/bc250-ace-queues/run.log"

[ $# -gt 0 ] || { echo "Usage: $0 <command>   (Steam launch options: $0 %command%)" >&2; exit 2; }

# One line per start: what the game got, and the game (Steam's AppId=, else the program's name).
note() {
    local game="" arg
    for arg in "${@:2}"; do case "$arg" in AppId=*) game=$arg; break ;; esac; done
    mkdir -p "$(dirname "$LOG")" 2>/dev/null &&
        echo "$(date '+%Y-%m-%d %H:%M:%S') ${game:-$(basename "$2")}: $1" >>"$LOG" 2>/dev/null
}

kernel=$(sed -n 's/^kernel=//p' "$TESTED" 2>/dev/null)
driver=$(sed -n 's/^driver=//p' "$TESTED" 2>/dev/null)
sum=$(sha256sum "$PREFIX/lib64/libvulkan_radeon.so" 2>/dev/null | cut -d' ' -f1)
if [ -z "$sum" ]; then
    note "system Mesa (the patched driver is not installed)" "$@"
elif [ "$kernel" != "$(uname -r)" ] || [ "$driver" != "$sum" ]; then
    note "system Mesa (the ACE queue test has not passed on kernel $(uname -r) with this driver)" "$@"
else
    files="$PREFIX/share/vulkan/icd.d/radeon_icd.x86_64.json"
    for f in /usr/share/vulkan/icd.d/radeon_icd.i686.json /usr/share/vulkan/icd.d/lvp_icd.x86_64.json; do
        [ -f "$f" ] && files="$files:$f"
    done
    export VK_DRIVER_FILES="$files" VK_ICD_FILENAMES="$files"
    note "patched RADV" "$@"
fi
exec "$@"
