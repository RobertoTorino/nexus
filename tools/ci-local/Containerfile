# The environment of .github/workflows/ci-nexus.yml for tools/ci-local.sh: Python 3.12 as CI sets it up, plus what
# GitHub's ubuntu-latest runner brings (Qt's runtime libraries, shellcheck, fakeroot, git). Built once; rebuilt when
# this file changes. The jobs run as an ordinary user, as on GitHub.
FROM docker.io/library/python:3.12-bookworm
RUN apt-get update -q \
 && apt-get install -y -q --no-install-recommends libegl1 libgl1 libxkbcommon0 libdbus-1-3 libfontconfig1 \
      libglib2.0-0 libpulse0 libgssapi-krb5-2 libevdev2 shellcheck fakeroot git rsync \
 && rm -rf /var/lib/apt/lists/*
RUN pip install -q --no-cache-dir --root-user-action=ignore "pyyaml>=6,<7" \
 && git config --system --add safe.directory '*'
