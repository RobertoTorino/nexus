{
  "about": "The programs and firmware the suites' apps use, and where Nexus Deps learns of their updates (nexus_deps/upstreams.py). Hand-written: id, name, what, compare, url, targets, how, and per app its suite, app, module and constants. Synced from the apps' code and their portal's apps.toml by `dev/deps/run.sh --sync-upstreams` (tests/test_upstreams.py fails while it is stale): repo, pin, version, home, version_file, name and launcher.",
  "github": [
    {
      "id": "rpcs3",
      "name": "RPCS3",
      "what": "the PlayStation 3 emulator",
      "compare": "version",
      "apps": [
        {
          "suite": "bc250-bazzite",
          "app": "rpcs3",
          "module": "rpcs3_manager/emulator.py",
          "constants": {
            "repo": "REPO",
            "pin": "LANDMARK",
            "version": "VERSION"
          },
          "repo": "RPCS3/rpcs3",
          "pin": "0.0.43",
          "version": "0.0.43-20395",
          "home": "~/.local/share/bc250-rpcs3-manager/emulator",
          "name": "RPCS3 Manager",
          "launcher": "~/.local/bin/bc250-rpcs3-manager"
        },
        {
          "suite": "bazzite-console",
          "app": "rpcs3",
          "module": "rpcs3_manager/emulator.py",
          "constants": {
            "repo": "REPO",
            "pin": "LANDMARK",
            "version": "VERSION"
