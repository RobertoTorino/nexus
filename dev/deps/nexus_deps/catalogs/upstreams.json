  "sony": [
    {
      "id": "dualsense",
      "name": "DualSense firmware",
      "what": "the firmware of the DualSense and DualSense Edge controllers",
      "kind": "controllers",
      "url": "https://fwupdater.dl.playstation.net/fwupdater/info.json",
      "targets": {
        "0x0004": "DualSense",
        "0x000B": "DualSense",
        "0x000E": "DualSense",
        "0x0044": "DualSense Edge"
      },
      "apps": [
        {
          "suite": "bc250-bazzite",
          "app": "hdcontrol",
          "name": "USB HD Control",
          "launcher": "~/.local/bin/bc250-usb-hdcontrol"
        },
        {
          "suite": "bazzite-console",
          "app": "hdcontrol",
          "name": "USB HD Control",
          "launcher": "~/.local/bin/ps5-usb-hdcontrol"
        }
      ],
      "how": "Connect the controller with a USB cable and open {apps}: it reads the controller's firmware, compares it with Sony's and updates it (the Edge's profiles are backed up first). Bluetooth is not enough for an update."
    },
    {
      "id": "ps4",
      "name": "PS4 system software",
      "what": "the PlayStation 4's system software, from Sony's update list",
      "kind": "ps4-updatelist",
      "url": "http://fus01.ps4.update.playstation.net/update/ps4/list/us/ps4-updatelist.xml",
      "apps": [
        {
          "suite": "bc250-bazzite",
          "app": "consoles",
          "name": "BC-250 PS Remote Play",
          "launcher": "~/.local/bin/bc250-console-link"
        }
      ],
      "how": "Update on the console: Settings, System Software Update. Remote Play with {apps} may need the console's newest system software."
    },
    {
      "id": "ps5",
      "name": "PS5 system software",
      "what": "the PlayStation 5's system software",
      "kind": "on-device",
      "apps": [
        {
          "suite": "bc250-bazzite",
          "app": "consoles",
          "name": "BC-250 PS Remote Play",
          "launcher": "~/.local/bin/bc250-console-link"
        }
      ],
      "how": "Sony publishes no update list a program can read safely. The console says when an update is out: Settings, System, System Software, System Software Update and Settings. Remote Play with {apps} may need the newest one."
    },
    {
      "id": "psportal",
      "name": "PlayStation Portal",
      "what": "the PlayStation Portal remote player's system software",
      "kind": "on-device",
      "apps": [],
      "how": "Sony publishes no update list for it. The Portal updates itself when it is online: Settings, System Software, System Software Update. Its latest version is listed at playstation.com."
    }
  ]
